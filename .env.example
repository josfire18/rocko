# Copy to .env and fill in. Never commit .env.
DISCORD_TOKEN=

# Add-ons to skip loading on this PC, comma-separated (e.g. clip,tarkov).
# To turn one off for just one server, use /rocko disable in that server instead.
ROCKO_DISABLED=

# /clip add-on (ClipKit)
# Speech model: tiny / base / small / medium (bigger = more accurate, slower)
WHISPER_MODEL=small
# chrome / firefox / edge, if Instagram starts refusing logged-out downloads
COOKIES_BROWSER=
